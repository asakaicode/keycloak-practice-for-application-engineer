---
interface Props {
	label?: string;
}

const { label = 'このページの内容を理解した' } = Astro.props;
---

<div class="progress-checklist not-content">
	<label>
		<input type="checkbox" class="progress-checklist__checkbox" />
		<span>{label}</span>
	</label>
</div>

<script>
	function initChecklists() {
		const STORAGE_KEY = 'keycloak-site-progress';

		function readProgress(): Record<string, boolean> {
			try {
				return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}');
			} catch {
				return {};
			}
		}

		function writeProgress(progress: Record<string, boolean>) {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
		}

		const pageId = window.location.pathname;
		const progress = readProgress();

		document.querySelectorAll<HTMLInputElement>('.progress-checklist__checkbox').forEach((checkbox) => {
			checkbox.checked = Boolean(progress[pageId]);
			checkbox.addEventListener('change', () => {
				const current = readProgress();
				current[pageId] = checkbox.checked;
				writeProgress(current);
			});
		});
	}

	initChecklists();
	document.addEventListener('astro:page-load', initChecklists);
</script>

<style>
	.progress-checklist {
		margin-block: 2rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-black);
	}

	.progress-checklist label {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		cursor: pointer;
		font-size: var(--sl-text-body-sm);
	}

	.progress-checklist input {
		width: 1.1rem;
		height: 1.1rem;
		cursor: pointer;
	}
</style>
